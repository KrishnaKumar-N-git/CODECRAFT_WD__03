# ======================================================
# GROCMART PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ======================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment (development | production)
NODE_ENV=production

# MongoDB Atlas Connection String (Get from https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/grocmart_db?retryWrites=true&w=majority

# JWT Secret Key for User Authentication
JWT_SECRET=grocmart_production_super_secret_jwt_key_2026_x99

# Client URL (Optional - default allows same-origin in production)
CLIENT_URL=https://your-app-name.onrender.com

# Razorpay Payment Gateway (Optional - Uses UPI QR Code Mode if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
